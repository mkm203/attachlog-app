{
  "expo": {
    "name": "AttachLog",
    "slug": "attachlog-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F5F7"
    },
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3F5F7",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.attachlog.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "AttachLog connects to the logbook server on your local network."
      }
    },
    "android": {
      "package": "com.attachlog.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B6B5D"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AttachLog to select a profile photo."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "eb8dca20-f616-430d-ba4a-ea560faa2fed"
      }
    }
  }
}
