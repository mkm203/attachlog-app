# Copy to .env for local runs. On Render these are set in the dashboard (see render.yaml).
# Local SQLite file (default):
DATABASE_URL=sqlite:///./attachlog.db
# Turso (production): the URL from `turso db show <name> --url` and a token from `turso db tokens create <name>`
# DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=eyJ...
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# The administrator account (you). Log in at http://localhost:8000/admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too-12345
# Optional: email for invitations and password reset codes. Pick ONE:
# Gmail (2-step verification on, then an App Password: myaccount.google.com/apppasswords). Works on your PC;
# Render's free plan blocks SMTP, so there use Brevo or Resend.
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# Brevo (HTTPS, works on Render free): create a key, verify your sender address, then
# BREVO_API_KEY=
# MAIL_FROM=AttachLog <you@gmail.com>
# Resend (resend.com):
# RESEND_API_KEY=
# MAIL_FROM=AttachLog <onboarding@resend.dev>
